---
import Layout from '../layouts/Layout.astro';

const phone = '+79107429995';
const phoneDisplay = '8-910-742-99-95';
const phoneCity = '+74742399995';
const phoneCityDisplay = '39-99-95';
const address = 'Индустриальная ул., 4/1, Липецк';
const yandexMapsUrl = 'https://yandex.ru/maps/org/kluch/';

const services = [
  { icon: '🔍', title: 'Диагностика', desc: 'Компьютерная диагностика всех систем', img: 'images/2026-11-03_20-35-44.png',
    details: 'Компьютерная диагностика всех систем автомобиля с использованием профессионального оборудования.',
    prices: [ { name: 'Компьютерная диагностика', price: 'от 500 ₽' }, { name: 'Диагностика подвески', price: 'от 800 ₽' }, { name: 'Диагностика ДВС', price: 'от 1000 ₽' }, { name: 'Бесплатно при ремонте', price: '0 ₽' } ] },
  { icon: '🔧', title: 'Ремонт подвески', desc: 'Замена амортизаторов, пружин, рычагов', img: 'images/2026-11-03_20-37-08.png',
    details: 'Полный спектр работ по ремонту ходовой части: замена амортизаторов, пружин, рычагов, сайлентблоков.',
    prices: [ { name: 'Замена амортизаторов (пара)', price: 'от 3000 ₽' }, { name: 'Замена пружин (пара)', price: 'от 2500 ₽' }, { name: 'Замена рычага', price: 'от 1500 ₽' }, { name: 'Замена сайлентблоков', price: 'от 1200 ₽' } ] },
  { icon: '⚙️', title: 'Ремонт ДВС', desc: 'Капитальный и текущий ремонт двигателей', img: 'фото/2026-11-03_20-37-33.png',
    details: 'Капитальный и текущий ремонт бензиновых и дизельных двигателей. Замена ГРМ, поршневой группы.',
    prices: [ { name: 'Замена ремня ГРМ', price: 'от 5000 ₽' }, { name: 'Замена цепи ГРМ', price: 'от 15000 ₽' }, { name: 'Капитальный ремонт', price: 'от 50000 ₽' }, { name: 'Замена прокладки ГБЦ', price: 'от 8000 ₽' } ] },
  { icon: '🛑', title: 'Ремонт тормозов', desc: 'Замена колодок, дисков, суппортов', img: 'фото/2026-11-03_20-37-58.png',
    details: 'Диагностика и ремонт тормозной системы. Замена колодок, дисков, суппортов, тормозных шлангов.',
    prices: [ { name: 'Замена колодок (ось)', price: 'от 1500 ₽' }, { name: 'Замена дисков (пара)', price: 'от 3000 ₽' }, { name: 'Замена суппорта', price: 'от 2500 ₽' }, { name: 'Замена тормозной жидкости', price: 'от 1000 ₽' } ] },
  { icon: '🛢️', title: 'Замена масла', desc: 'Масло ДВС, фильтры, свечи', img: 'фото/2026-11-03_20-38-45.png',
    details: 'Замена моторного масла, масляного фильтра, воздушного фильтра, салонного фильтра и свечей зажигания.',
    prices: [ { name: 'Замена масла ДВС + фильтр', price: 'от 800 ₽' }, { name: 'Замена воздушного фильтра', price: 'от 300 ₽' }, { name: 'Замена салонного фильтра', price: 'от 400 ₽' }, { name: 'Замена свечей зажигания', price: 'от 600 ₽' } ] },
  { icon: '💨', title: 'Выхлопная система', desc: 'Глушители, катализаторы, резонаторы', img: 'фото/2026-11-03_20-39-06.png',
    details: 'Ремонт и замена элементов выхлопной системы: глушителей, катализаторов, резонаторов, гофр.',
    prices: [ { name: 'Замена глушителя', price: 'от 2000 ₽' }, { name: 'Замена катализатора', price: 'от 5000 ₽' }, { name: 'Замена резонатора', price: 'от 2500 ₽' }, { name: 'Ремонт гофры', price: 'от 1500 ₽' } ] },
  { icon: '🛞', title: 'Шиномонтаж', desc: 'Сезонная замена, балансировка', img: 'фото/2026-11-03_20-39-32.png',
    details: 'Сезонная замена шин, балансировка колёс, ремонт проколов и боковых порезов. Шиномонтаж до R20.',
    prices: [ { name: 'Сезонная замена (4 колеса)', price: 'от 1600 ₽' }, { name: 'Балансировка (4 колеса)', price: 'от 1200 ₽' }, { name: 'Ремонт прокола', price: 'от 500 ₽' }, { name: 'Шиномонтаж R19-R20', price: 'от 2500 ₽' } ] },
  { icon: '🔩', title: 'Автозапчасти', desc: 'Оригинальные и аналоговые запчасти', img: 'фото/2026-11-03_20-40-01.png',
    details: 'Продажа оригинальных запчастей и качественных аналогов. Подбор по VIN-коду.',
    prices: [ { name: 'Оригинальные запчасти', price: 'по каталогу' }, { name: 'Аналоги', price: 'от -30%' }, { name: 'Подбор по VIN', price: 'бесплатно' }, { name: 'Доставка', price: '1-3 дня' } ] },
  { icon: '🚿', title: 'Автомойка', desc: 'Комплексная мойка кузова и салона', img: 'images/2026-11-03_20-36-32.png',
    details: 'Комплексная мойка кузова, уборка салона, химчистка. Мойка двигателя и подкапотного пространства.',
    prices: [ { name: 'Мойка кузова', price: 'от 500 ₽' }, { name: 'Комплексная мойка', price: 'от 1000 ₽' }, { name: 'Химчистка салона', price: 'от 3000 ₽' }, { name: 'Мойка двигателя', price: 'от 800 ₽' } ] },
];

const stats = [
  { value: '4.8', label: 'Рейтинг', suffix: '⭐' },
  { value: '62', label: 'Оценок', suffix: '' },
  { value: '9-19', label: 'Часы работы', suffix: '' },
  { value: '7', label: 'Дней в неделю', suffix: '' },
];

const reviews = [
  { name: 'Александр', text: 'Отличный сервис! Быстро и качественно отремонтировали подвеску. Цены адекватные.' },
  { name: 'Марина', text: 'Обслуживаюсь здесь уже год. Всегда всё чётко, вовремя и с гарантией.' },
  { name: 'Дмитрий', text: 'Делал капитальный ремонт двигателя. Сделали всё качественно, с гарантией.' },
  { name: 'Елена', text: 'Удобно, что работают без выходных. Записалась на диагностику в субботу.' },
];

const galleryPhotos = ['2026-11-03_20-35-44.png', '2026-11-03_20-37-08.png', '2026-11-03_20-37-33.png', '2026-11-03_20-37-58.png', '2026-11-03_20-38-45.png', '2026-11-03_20-39-06.png', '2026-11-03_20-39-32.png', '2026-11-03_20-40-01.png'];
---

<Layout title="Автосервис «Ключ» — Липецк | Ремонт и обслуживание автомобилей">
  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: url('images/2026-11-03_20-37-33.png'); background-size: cover; background-position: center;"></div>
    
    <div class="relative z-10 container mx-auto px-4 py-20 text-center">
      <div class="inline-block mb-6 px-4 py-2 bg-yellow-500/20 border border-yellow-500/50 rounded-full">
        <span class="text-yellow-400 font-semibold">⭐ Рейтинг 4.8 на Яндекс.Картах</span>
      </div>
      
      <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight">АВТОСЕРВИС<br>«КЛЮЧ»</h1>
      
      <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-2xl mx-auto">
        Профессиональный ремонт и обслуживание автомобилей в Липецке
      </p>
      
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <div class="flex items-center gap-2 px-6 py-3 bg-gray-800/50 backdrop-blur rounded-lg border border-gray-700">
          <span class="text-2xl">⭐</span>
          <span class="text-xl font-bold">4.8</span>
          <span class="text-gray-400">/ 62 оценки</span>
        </div>
        <div class="flex items-center gap-2 px-6 py-3 bg-gray-800/50 backdrop-blur rounded-lg border border-gray-700">
          <span class="text-2xl">🕐</span>
          <span class="text-xl font-bold">9:00–19:00</span>
          <span class="text-gray-400">без выходных</span>
        </div>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`tel:${phone}`} class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-lg transition-all duration-300 hover:scale-105 shadow-lg shadow-green-600/30">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {phoneDisplay}
        </a>
        
        <a href={yandexMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold text-lg rounded-lg transition-all duration-300 hover:scale-105 shadow-lg shadow-blue-600/30">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Построить маршрут
        </a>
      </div>
    </div>
    
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-20 bg-gray-800">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Наши услуги</h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Полный спектр услуг для отечественных и импортных автомобилей
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, idx) => (
          <button 
            type="button"
            class="group bg-gray-900 rounded-xl border border-gray-700 hover:border-yellow-500/50 transition-all duration-300 hover:-translate-y-1 overflow-hidden text-left cursor-pointer"
            onclick={`openModal(${idx})`}
          >
            <div class="h-48 overflow-hidden">
              <img src={service.img} alt={service.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-6">
              <div class="text-3xl mb-3">{service.icon}</div>
              <h3 class="text-xl font-bold mb-2 group-hover:text-yellow-400 transition-colors">{service.title}</h3>
              <p class="text-gray-400">{service.desc}</p>
              <div class="mt-4 text-yellow-400 text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Нажмите для подробностей →</div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Modals -->
  {services.map((service, idx) => (
    <div id={`modal-${idx}`} class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm" onclick={`closeModal(${idx})`}>
      <div class="bg-gray-900 rounded-2xl border border-gray-700 max-w-lg w-full max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
        <div class="relative">
          <img src={service.img} alt={service.title} class="w-full h-56 object-cover rounded-t-2xl" />
          <button type="button" class="absolute top-4 right-4 w-10 h-10 bg-black/50 hover:bg-black/70 rounded-full flex items-center justify-center text-white text-xl transition-colors" onclick={`closeModal(${idx})`}>✕</button>
        </div>
        <div class="p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-4xl">{service.icon}</span>
            <h3 class="text-2xl font-bold text-yellow-400">{service.title}</h3>
          </div>
          <p class="text-gray-300 mb-6">{service.details}</p>
          <h4 class="text-lg font-bold mb-4 text-white">Цены:</h4>
          <div class="space-y-3">
            {service.prices.map((item) => (
              <div class="flex justify-between items-center py-2 border-b border-gray-800">
                <span class="text-gray-300">{item.name}</span>
                <span class="text-yellow-400 font-bold">{item.price}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-4 border-t border-gray-800">
            <a href={`tel:${phone}`} class="block w-full py-3 bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold text-center rounded-lg transition-colors">
              Позвонить и записаться
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- Why Us / Stats -->
  <section class="py-20 bg-gray-900">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Почему выбирают нас</h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Современное оборудование ROSSVIK и опытные мастера
      </p>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
        {stats.map((stat) => (
          <div class="text-center p-6 bg-gray-800 rounded-xl border border-gray-700">
            <div class="text-4xl md:text-5xl font-bold text-yellow-400 mb-2">
              {stat.value}{stat.suffix}
            </div>
            <div class="text-gray-400">{stat.label}</div>
          </div>
        ))}
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="flex items-center gap-4 p-6 bg-gray-800 rounded-xl border border-gray-700">
          <div class="text-3xl">✓</div>
          <div class="text-gray-300">Гарантия на все виды работ</div>
        </div>
        <div class="flex items-center gap-4 p-6 bg-gray-800 rounded-xl border border-gray-700">
          <div class="text-3xl">✓</div>
          <div class="text-gray-300">Оригинальные запчасти и качественные аналоги</div>
        </div>
        <div class="flex items-center gap-4 p-6 bg-gray-800 rounded-xl border border-gray-700">
          <div class="text-3xl">✓</div>
          <div class="text-gray-300">Бесплатная диагностика при ремонте</div>
        </div>
        <div class="flex items-center gap-4 p-6 bg-gray-800 rounded-xl border border-gray-700">
          <div class="text-3xl">✓</div>
          <div class="text-gray-300">Работаем без выходных и перерывов</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section id="gallery" class="py-20 bg-gray-800">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Фотогалерея</h2>
      <p class="text-gray-400 text-center mb-12">Наш сервис изнутри</p>
      
      <div class="relative max-w-4xl mx-auto">
        <div class="overflow-hidden rounded-xl border border-gray-700">
          <div id="carousel" class="flex transition-transform duration-500 ease-in-out">
            {galleryPhotos.map((photo) => (
              <div class="w-full flex-shrink-0">
                <img src={`images/${photo}`} alt="Автосервис «Ключ»" class="w-full h-96 object-cover" loading="lazy" />
              </div>
            ))}
          </div>
        </div>
        
        <button type="button" class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-black/50 hover:bg-black/70 rounded-full flex items-center justify-center text-white text-2xl transition-colors z-10" onclick="prevSlide()">
          ←
        </button>
        <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-black/50 hover:bg-black/70 rounded-full flex items-center justify-center text-white text-2xl transition-colors z-10" onclick="nextSlide()">
          →
        </button>
        
        <div class="flex justify-center gap-2 mt-4">
          {galleryPhotos.map((_, idx) => (
            <button type="button" class="carousel-dot w-3 h-3 rounded-full bg-gray-600 hover:bg-gray-500 transition-colors" onclick={`goToSlide(${idx})`}></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section id="reviews" class="py-20 bg-gray-900 overflow-hidden">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Отзывы клиентов</h2>
      <p class="text-gray-400 text-center mb-12">Что говорят о нас клиенты</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {reviews.map((review) => (
          <div class="p-6 bg-gray-800 rounded-xl border border-gray-700">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 bg-yellow-500/20 rounded-full flex items-center justify-center">
                <span class="text-yellow-400 font-bold text-xl">{review.name[0]}</span>
              </div>
              <div>
                <div class="font-bold">{review.name}</div>
                <div class="text-yellow-400 text-sm">★★★★★</div>
              </div>
            </div>
            <p class="text-gray-300">"{review.text}"</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacts -->
  <section id="contacts" class="py-20 bg-gray-800">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Контакты</h2>
      <p class="text-gray-400 text-center mb-12">Приезжайте — мы всегда рады помочь</p>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="space-y-6">
          <div class="flex items-start gap-4 p-6 bg-gray-900 rounded-xl border border-gray-700">
            <div class="text-2xl">📍</div>
            <div>
              <div class="font-bold mb-1">Адрес</div>
              <div class="text-gray-400">{address}</div>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-6 bg-gray-900 rounded-xl border border-gray-700">
            <div class="text-2xl">📞</div>
            <div>
              <div class="font-bold mb-1">Телефоны</div>
              <a href={`tel:${phoneCity}`} class="block text-yellow-400 hover:text-yellow-300 transition-colors text-lg">{phoneCityDisplay}</a>
              <a href={`tel:${phone}`} class="block text-yellow-400 hover:text-yellow-300 transition-colors text-lg">{phoneDisplay}</a>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-6 bg-gray-900 rounded-xl border border-gray-700">
            <div class="text-2xl">🕐</div>
            <div>
              <div class="font-bold mb-1">Время работы</div>
              <div class="text-gray-400">Пн–Вс: 9:00 – 19:00<br>Без перерыва и выходных</div>
            </div>
          </div>
          
          <div class="flex items-start gap-4 p-6 bg-gray-900 rounded-xl border border-gray-700">
            <div class="text-2xl">⭐</div>
            <div>
              <div class="font-bold mb-1">Рейтинг</div>
              <div class="text-gray-400">4.8 из 5 (62 оценки)</div>
            </div>
          </div>
        </div>
        
        <div class="rounded-xl overflow-hidden border border-gray-700 h-96 lg:h-auto">
          <iframe src="https://yandex.ru/map-widget/v1/?text=%D0%9A%D0%BB%D1%8E%D1%87%20%D0%98%D0%BD%D0%B4%D1%83%D1%81%D1%82%D1%80%D0%B8%D0%B0%D0%BB%D1%8C%D0%BD%D0%B0%D1%8F%204%2F1%20%D0%9B%D0%B8%D0%BF%D0%B5%D1%86%D0%BA&z=16" width="100%" height="100%" frameborder="0" class="grayscale hover:grayscale-0 transition-all duration-500"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-20 bg-gray-900">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Оставить заявку</h2>
      <p class="text-gray-400 text-center mb-12">Перезвоним в течение 15 минут</p>
      
      <div class="max-w-2xl mx-auto">
        <form id="contactForm" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-300 mb-2">Ваше имя</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-yellow-500 transition-colors" placeholder="Иван" />
            </div>
            <div>
